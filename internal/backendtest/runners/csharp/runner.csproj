<!--
  The project one case of the corpus is built as. Everything in the case directory is compiled: the generated scanner,
  the generated parser and the runner next to them. There are no package references, which is what lets the build run
  with no network at all.

  The four properties below are what "dotnet new console" writes, taken verbatim, so the generated code is held to the
  configuration a normal project is scaffolded with rather than to one picked here. TreatWarningsAsErrors is the one
  addition: a warning in generated code is a defect the person who generated it cannot fix by hand, so it has to fail
  the run rather than scroll past.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
