1:6     SHIFT   NUMBER "2"
1:7     REDUCE  sum => sum PLUS NUMBER
1:7     SHIFT   RPAREN ")"
1:9     REDUCE  group => LPAREN sum RPAREN
1:9     REDUCE  groups => group
1:9     SHIFT   LBRACKET "["
1:10    SHIFT   NUMBER "3"
1:12    REDUCE  sum => NUMBER
1:12    SHIFT   PLUS "+"
1:14    SHIFT   NUMBER "4"
1:15    REDUCE  sum => sum PLUS NUMBER
1:15    SHIFT   RBRACKET "]"
1:17    REDUCE  group => LBRACKET sum RBRACKET
1:17    REDUCE  groups => groups group
1:17    SHIFT   LBRACE "{"
1:18    SHIFT   NUMBER "5"
1:20    REDUCE  sum => NUMBER
1:20    SHIFT   PLUS "+"
1:22    SHIFT   NUMBER "6"
1:23    REDUCE  sum => sum PLUS NUMBER
1:23    SHIFT   RBRACE "}"
