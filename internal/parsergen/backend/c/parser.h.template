    size_t cell_column = {{ .Const "ActionCheck" }}[cell_idx];
    size_t action = {{ .Const "DefaultActionByState" }}[state];
    {{ .Type "ParseNode" }} node;

    if (cell_column == column) {
        /* An entry the state has of its own beats its default action, which is what keeps a token the grammar rejects
           on purpose an error even in a state which reduces on everything else. */
        action = {{ .Const "ActionNext" }}[cell_idx];
    }

    switch (action & {{ .Const "ActionKindMask" }}) {
    case {{ .Const "ActionKindShift" }}:
        if (!{{ .Func "ParserPushState" }}(parser, action >> {{ .Const "ActionKindBits" }})) {
            return {{ .Const "StepFailed" }};
        }
        node.symbol.kind = {{ .Const "SymbolKindTerminal" }};
        node.symbol.value.terminal = terminal;
        node.lexeme = source->lexeme(source->context);
        node.children = NULL;
        node.child_count = 0;
        if (!{{ .Func "ParserPushNode" }}(parser, &node)) {
            return {{ .Const "StepFailed" }};
        }
        source->next(source->context);
        if (parser->error_recovery_shifts_remaining > 0) {
            /* Getting tokens of the input shifted again is what makes the parser trust its position. */
            parser->error_recovery_shifts_remaining--;
        }
        return {{ .Const "StepContinue" }};
    case {{ .Const "ActionKindReduce" }}:
        if (!{{ .Func "ParserReduce" }}(parser, action >> {{ .Const "ActionKindBits" }})) {
            return {{ .Const "StepFailed" }};
        }
        return {{ .Const "StepContinue" }};
    case {{ .Const "ActionKindAccept" }}:
        return {{ .Const "StepAccept" }};
    case {{ .Const "ActionKindError" }}:
        *error = {{ .Func "ParseErrorAt" }}({{ .Const "ErrorKindSyntax" }}, source, state);
        return {{ .Const "StepFailed" }};
    default:
        /* Every value the mask selects has a case of its own, so this is never reached. It is here to make the switch
           complete. */
        *error = {{ .Func "ParseErrorAt" }}({{ .Const "ErrorKindInternal" }}, source, state);
        return {{ .Const "StepFailed" }};
    }
}

/// Puts the parser back where it can carry on with the remaining input after a syntax error. Once it reports false,
/// the parse is given up.
///
/// This is panic mode recovery as described in section 7 "Error Handling" of the yacc report: the stack is popped
/// until a state is reached which can shift the error symbol, and the symbol is shifted there. Everything the popped
/// states had parsed is discarded with them. The token which caused the error is kept for the resumed state to look
/// at, and only discarded when the parse fails on it a second time.
static bool {{ .Func "ParserRecoverFromError" }}({{ .Type "Parser" }} *parser, const {{ .Type "TokenSkipperScanner" }} *source) {
    {{ .Type "ParseNode" }} node;
    size_t next_state;

    if (parser->error_recovery_shifts_remaining == {{ .Const "ErrorRecoveryShifts" }}) {
        /* Nothing was shifted since the last error, so the parser is failing on the token it already failed on. */
        if (source->token(source->context) == {{ .Const "TokenEndToken" }}) {
            /* The end of input is the one token which cannot be discarded. */
            return false;
        }
        source->next(source->context);
    }
    parser->error_recovery_shifts_remaining = {{ .Const "ErrorRecoveryShifts" }};

    for (;;) {
        if ({{ .Func "ErrorShiftState" }}({{ .Func "ParserCurrentState" }}(parser), &next_state)) {
            /* Shift the error symbol. Its node stands for the dropped part of the input and has no lexeme. */
            if (!{{ .Func "ParserPushState" }}(parser, next_state)) {
                return false;
            }
            node.symbol.kind = {{ .Const "SymbolKindTerminal" }};
            node.symbol.value.terminal = {{ .Const "TokenErrorToken" }};
            node.lexeme.data = NULL;
            node.lexeme.length = 0;
            node.children = NULL;
            node.child_count = 0;
            return {{ .Func "ParserPushNode" }}(parser, &node);
        }
        if (parser->state_count == 1) {
            /* Only the state the parse started in is left and it cannot shift the error symbol either. */
            return false;
        }
        /* The state cannot resume here, so it is dropped together with what it had parsed. One state carries one node,
           so dropping one drops one. */
        parser->state_count--;
        parser->node_count--;
    }
}

void {{ .Func "ParserInit" }}({{ .Type "Parser" }} *parser) {
    parser->state_stack = NULL;
    parser->state_count = 0;
    parser->state_capacity = 0;
    parser->node_stack = NULL;
    parser->node_count = 0;
    parser->node_capacity = 0;
    parser->errors = NULL;
    parser->error_count = 0;
    parser->error_capacity = 0;
    parser->arena = NULL;
    parser->error_recovery_shifts_remaining = 0;
    parser->out_of_memory = false;
}

void {{ .Func "ParserFree" }}({{ .Type "Parser" }} *parser) {
    free(parser->state_stack);
    free(parser->node_stack);
    {{ .Func "ParserInit" }}(parser);
}

void {{ .Func "ParseResultFree" }}({{ .Type "ParseResult" }} *result) {
    {{ .Func "ArenaFree" }}(result->arena);
    free(result->errors);
    result->tree = NULL;
    result->errors = NULL;
    result->error_count = 0;
    result->arena = NULL;
}

{{ .Type "ParseResult" }} {{ .Func "ParserParse" }}({{ .Type "Parser" }} *parser, const {{ .Type "TokenSkipperScanner" }} *source) {
    {{ .Type "ParseResult" }} result;
    {{ .Type "ParseError" }} failure;
    {{ .Type "StepKind" }} kind;

    result.tree = NULL;
    result.errors = NULL;
    result.error_count = 0;
    result.arena = NULL;

    parser->state_count = 0;
    parser->node_count = 0;
    parser->errors = NULL;
    parser->error_count = 0;
    parser->error_capacity = 0;
    parser->arena = NULL;
    parser->error_recovery_shifts_remaining = 0;
    parser->out_of_memory = false;

    /* One error slot up front, so that running out of memory later can always be reported. */
    if (!{{ .Func "ParserReserveErrors" }}(parser, 1) || !{{ .Func "ParserPushState" }}(parser, 0)) {
        free(parser->errors);
        parser->errors = NULL;
        parser->error_capacity = 0;
        return result;
    }

    /* A source with no tokens at all reports false right away. That is not an error: the token is the end of input
       either way, and whether a parse of nothing but that is legal is for the table to decide. */
    source->next(source->context);

    for (;;) {
        kind = {{ .Func "ParserStep" }}(parser, source, &failure);

        if (parser->out_of_memory) {
            {{ .Func "ParserReportOutOfMemory" }}(parser, source, {{ .Func "ParserCurrentState" }}(parser));
            break;
        }
        if (kind == {{ .Const "StepContinue" }}) {
            continue;
        }
        if (kind == {{ .Const "StepAccept" }}) {
            /* What is left on the node stack is the start symbol, which is the root of the tree. */
            if (parser->node_count > 0) {
                {{ .Type "ParseNode" }} *root = {{ .Func "ArenaAllocate" }}(&parser->arena, 1);
                if (root == NULL) {
                    parser->out_of_memory = true;
                    {{ .Func "ParserReportOutOfMemory" }}(parser, source, {{ .Func "ParserCurrentState" }}(parser));
                    break;
                }
                *root = parser->node_stack[0];
                result.tree = root;
            }
            break;
        }

        /* The step neither went on nor accepted, so it failed and the error says why. */
        if (failure.kind != {{ .Const "ErrorKindSyntax" }}) {
            /* Only an error in the input can be recovered from. */
            {{ .Func "ParserAppendError" }}(parser, &failure);
            break;
        }
        if (parser->error_recovery_shifts_remaining == 0) {
            /* While recovering, the parser is not in sync with the input, so the errors it runs into there follow from
               the one already reported. */
            if (!{{ .Func "ParserAppendError" }}(parser, &failure)) {
                {{ .Func "ParserReportOutOfMemory" }}(parser, source, {{ .Func "ParserCurrentState" }}(parser));
                break;
            }
        }
        if (!{{ .Func "ParserRecoverFromError" }}(parser, source)) {
            if (parser->out_of_memory) {
                {{ .Func "ParserReportOutOfMemory" }}(parser, source, {{ .Func "ParserCurrentState" }}(parser));
            }
            break;
        }
    }

    result.errors = parser->errors;
    result.error_count = parser->error_count;
    result.arena = parser->arena;

    if (result.tree == NULL) {
        /* Nothing references the nodes the parse had built, so they go now rather than with the result. */
        {{ .Func "ArenaFree" }}(result.arena);
        result.arena = NULL;
    }

    parser->errors = NULL;
    parser->error_count = 0;
    parser->error_capacity = 0;
    parser->arena = NULL;
    return result;
}

