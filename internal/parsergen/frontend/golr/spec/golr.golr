// This GoLR grammar describes how GoLR files are tokenized and parsed.

@scanner {
    NEWLINE:               /\n|\r\n/ @fragment;
    HORIZONTAL_WHITESPACE: /[ \t\f\v]/ @fragment;
    WHITESPACE:            /({NEWLINE}|{HORIZONTAL_WHITESPACE})+/ @skip;

    MULTILINE_COMMENT: /\/\*([^\*]|(\*+[^\*\/]))*\*+\// @fragment;
    LINE_COMMENT:      /\/\/.*/ @fragment;
    COMMENT:           /{MULTILINE_COMMENT}|{LINE_COMMENT}/ @skip;

    SCANNER:    "@scanner";
    PARSER:     "@parser";
    PRECEDENCE: "@precedence";
    NAME:       "@name";
    START:      "@start";
    LEFT:       "@left";
    RIGHT:      "@right";
    NONE:       "@none";
    SKIP:       "@skip";
    EMPTY:      "@empty";
    ERROR:      "@error";
    FRAGMENT:   "@fragment";
    LBRACE:     "{";
    RBRACE:     "}";
    LPAREN:     "(";
    RPAREN:     ")";
    COLON:      ":";
    SEMI:       ";";
    PIPE:       "|";
    COMMA:      ",";

    IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/;
    // A regex or string literal stays on one line: excluding the newline keeps a missing
    // closing delimiter from swallowing the rest of the file.
    REGEX:      /\/([^\n\/]|\\\/)*\//;
    STRING:     /"([^\n"]|\\")*"/;
}

@parser {
    file
        : scanner_section parser_section
        ;

    // ================================================================================
    // Scanner section
    // ================================================================================

    scanner_section
        : "@scanner" "{" scanner_decl_list "}"
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@scanner" "{" scanner_decl_list @error "}"
        ;

    scanner_decl_list
        : @empty
        | scanner_decl_list scanner_decl
        ;

    scanner_decl
        : IDENTIFIER ":" scanner_decl_rhs ";"
        // keep the terminal name, skip a broken right hand side up to the ";"
        | IDENTIFIER ":" @error ";"
        // the "IDENTIFIER :" itself is broken, skip the whole declaration
        | @error ";"
        ;

    scanner_decl_rhs
        : scanner_pattern scanner_annotation_list
        | "@empty" scanner_annotation_list
        ;

    scanner_pattern
        : REGEX
        | STRING
        ;

    scanner_annotation_list
        : @empty
        | scanner_annotation_list scanner_annotation
        ;

    scanner_annotation
        : "@skip"
        | "@fragment"
        ;

    // ================================================================================
    // Parser section
    // ================================================================================

    parser_section
        : "@parser" "{" start_decl precedence_section rule_decl_list "}"
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@parser" "{" start_decl precedence_section rule_decl_list @error "}"
        ;

    start_decl
        : @empty
        | "@start" ":" IDENTIFIER ";"
        // a half typed @start must not take the whole parser section with it
        | "@start" @error ";"
        ;

    precedence_section
        : @empty
        | "@precedence" "{" precedence_decl_list "}"
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@precedence" "{" precedence_decl_list @error "}"
        ;

    precedence_decl_list
        : @empty
        | precedence_decl_list precedence_decl
        ;

    precedence_decl
        : associativity ":" symbol_list ";"
        // keep the associativity, skip a broken symbol list up to the ";"
        | associativity ":" @error ";"
        // the "associativity :" itself is broken, skip the whole declaration
        | @error ";"
        ;

    associativity
        : "@left"
        | "@right"
        | "@none"
        | "@precedence"
        ;

    rule_decl_list
        : @empty
        | rule_decl_list production_decl
        ;

    production_decl
        : IDENTIFIER ":" alternative_list ";"
        // keep the nonterminal name while its body is being typed, skip up to the ";"
        | IDENTIFIER ":" @error ";"
        // the "IDENTIFIER :" itself is broken, skip the whole declaration
        | @error ";"
        ;

    alternative_list
        : alternative
        | alternative_list "|" alternative
        ;

    alternative
        : symbol_list alternative_annotation_list
        | "@empty" alternative_annotation_list
        ;

    alternative_annotation_list
        : @empty
        | alternative_annotation_list alternative_annotation
        ;

    alternative_annotation
        : "@precedence" "(" symbol ")"
        | "@name" "(" IDENTIFIER ")"
        ;

    symbol_list
        : symbol
        | symbol_list symbol
        ;

    symbol
        : IDENTIFIER
        | STRING
        | "@error"
        ;
}
