// This GoLR grammar describes how GoLR files are tokenized and parsed.

@scanner {
    NEWLINE:               /\n|\r\n/ @fragment;
    HORIZONTAL_WHITESPACE: /[ \t\f\v]/ @fragment;
    WHITESPACE:            /({NEWLINE}|{HORIZONTAL_WHITESPACE})+/ @skip;

    MULTILINE_COMMENT: /\/\*([^\*]|(\*+[^\*\/]))*\*+\// @fragment;
    LINE_COMMENT:      /\/\/.*/ @fragment;
    COMMENT:           /{MULTILINE_COMMENT}|{LINE_COMMENT}/ @skip;

    SCANNER:    "@scanner";
    PARSER:     "@parser";
    PRECEDENCE: "@precedence";
    NAME:       "@name";
    START:      "@start";
    LEFT:       "@left";
    RIGHT:      "@right";
    NONE:       "@none";
    SKIP:       "@skip";
    EMPTY:      "@empty";
    ERROR:      "@error";
    FRAGMENT:   "@fragment";
    LBRACE:     "{";
    RBRACE:     "}";
    LPAREN:     "(";
    RPAREN:     ")";
    COLON:      ":";
    SEMI:       ";";
    PIPE:       "|";
    COMMA:      ",";

    IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/;
    // A regex or string literal stays on one line: excluding the newline keeps a missing
    // closing delimiter from swallowing the rest of the file.
    REGEX:      /\/([^\n\/]|\\\/)*\//;
    STRING:     /"([^\n"]|\\")*"/;
}

@parser {
    file
        : scanner_section parser_section @name(file)
        ;

    // ================================================================================
    // Scanner section
    // ================================================================================

    scanner_section
        : "@scanner" "{" scanner_decl_list "}" @name(scanner_section)
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@scanner" "{" scanner_decl_list @error "}" @name(scanner_section_broken)
        ;

    scanner_decl_list
        : @empty @name(scanner_decl_list_empty)
        | scanner_decl_list scanner_decl @name(scanner_decl_list_more)
        ;

    scanner_decl
        : IDENTIFIER ":" scanner_decl_rhs ";" @name(scanner_decl)
        // keep the terminal name, skip a broken right hand side up to the ";"
        | IDENTIFIER ":" @error ";" @name(scanner_decl_broken_rhs)
        // the "IDENTIFIER :" itself is broken, skip the whole declaration
        | @error ";" @name(scanner_decl_broken)
        ;

    scanner_decl_rhs
        : scanner_pattern scanner_annotation_list @name(scanner_decl_rhs_pattern)
        | "@empty" scanner_annotation_list @name(scanner_decl_rhs_empty)
        ;

    scanner_pattern
        : REGEX @name(scanner_pattern_regex)
        | STRING @name(scanner_pattern_literal)
        ;

    scanner_annotation_list
        : @empty @name(scanner_annotation_list_empty)
        | scanner_annotation_list scanner_annotation @name(scanner_annotation_list_more)
        ;

    scanner_annotation
        : "@skip" @name(scanner_annotation_skip)
        | "@fragment" @name(scanner_annotation_fragment)
        ;

    // ================================================================================
    // Parser section
    // ================================================================================

    parser_section
        : "@parser" "{" start_decl precedence_section rule_decl_list "}" @name(parser_section)
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@parser" "{" start_decl precedence_section rule_decl_list @error "}" @name(parser_section_broken)
        ;

    start_decl
        : @empty @name(start_decl_absent)
        | "@start" ":" IDENTIFIER ";" @name(start_decl)
        // a half typed @start must not take the whole parser section with it
        | "@start" @error ";" @name(start_decl_broken)
        ;

    precedence_section
        : @empty @name(precedence_section_absent)
        | "@precedence" "{" precedence_decl_list "}" @name(precedence_section)
        // a broken tail or a missing ";" resyncs at the closing brace
        | "@precedence" "{" precedence_decl_list @error "}" @name(precedence_section_broken)
        ;

    precedence_decl_list
        : @empty @name(precedence_decl_list_empty)
        | precedence_decl_list precedence_decl @name(precedence_decl_list_more)
        ;

    precedence_decl
        : associativity ":" symbol_list ";" @name(precedence_decl)
        // keep the associativity, skip a broken symbol list up to the ";"
        | associativity ":" @error ";" @name(precedence_decl_broken_rhs)
        // the "associativity :" itself is broken, skip the whole declaration
        | @error ";" @name(precedence_decl_broken)
        ;

    associativity
        : "@left" @name(associativity_left)
        | "@right" @name(associativity_right)
        | "@none" @name(associativity_none)
        | "@precedence" @name(associativity_precedence)
        ;

    rule_decl_list
        : @empty @name(rule_decl_list_empty)
        | rule_decl_list production_decl @name(rule_decl_list_more)
        ;

    production_decl
        : IDENTIFIER ":" alternative_list ";" @name(production_decl)
        // keep the nonterminal name while its body is being typed, skip up to the ";"
        | IDENTIFIER ":" @error ";" @name(production_decl_broken_rhs)
        // the "IDENTIFIER :" itself is broken, skip the whole declaration
        | @error ";" @name(production_decl_broken)
        ;

    alternative_list
        : alternative @name(alternative_list_one)
        | alternative_list "|" alternative @name(alternative_list_more)
        ;

    alternative
        : symbol_list alternative_annotation_list @name(alternative)
        | "@empty" alternative_annotation_list @name(alternative_empty)
        ;

    alternative_annotation_list
        : @empty @name(alternative_annotation_list_empty)
        | alternative_annotation_list alternative_annotation @name(alternative_annotation_list_more)
        ;

    alternative_annotation
        : "@precedence" "(" symbol ")" @name(alternative_annotation_precedence)
        | "@name" "(" IDENTIFIER ")" @name(alternative_annotation_name)
        ;

    symbol_list
        : symbol @name(symbol_list_one)
        | symbol_list symbol @name(symbol_list_more)
        ;

    symbol
        : IDENTIFIER @name(symbol_identifier)
        | STRING @name(symbol_literal)
        | "@error" @name(symbol_error)
        ;
}
